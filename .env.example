# Salin ke .env lalu isi nilainya. Jangan commit .env.

# Connection string Neon (gunakan host -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Secret penanda tangan sesi JWT, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

PORT=3005
