# Salin ke .env lalu isi nilainya. Jangan commit .env.

# Connection string Neon (gunakan host -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Secret penanda tangan sesi JWT, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

PORT=3005

# Lupa kata sandi via email (Resend). Kosongkan untuk menonaktifkan; halaman tetap ada
# tetapi meminta pengguna menghubungi Owner.
# RESEND_FROM harus memakai domain yang sudah diverifikasi di Resend, mis. "Manajemen Tugas <no-reply@domainanda.com>".
# APP_URL = URL publik aplikasi, dipakai untuk tautan di email.
RESEND_API_KEY=
RESEND_FROM=
APP_URL=https://manajemen-tugas-web.vercel.app

# Hanya untuk database kosong: akun Owner pertama dibuat saat `npm run seed` / server lokal start.
# Hapus SEED_OWNER_PASSWORD setelah akun dibuat.
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
