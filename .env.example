# Template Konfigurasi Environment (Aman di-commit ke Git)
# Salin file ini menjadi .env lalu isi nilainya sesuai akun Anda

# 1. URL Koneksi Basis Data Neon PostgreSQL (Wajib menggunakan mode pooler)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-lucky-salad-b300zerb-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Kunci Rahasia Sesi Login (Minimal 32 karakter acak untuk enkripsi cookie)
ADMIN_SESSION_SECRET="ganti_dengan_string_acak_panjang_dan_rahasia_anda_disini"
