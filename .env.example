# Salin ke .env lalu isi nilainya. Jangan commit .env.

# .env.local (jika ada) berisi kredensial lokal tambahan. Jangan pernah commit file ini.
# Lindungi dengan permission filesystem:
#   Windows: batasi akses via NTFS ACL (hanya user yang menjalankan aplikasi).
#   Linux/macOS: chmod 600 .env.local
# .env.example hanya berisi placeholder, bukan kredensial aktif.

# Connection string Neon (gunakan host -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Secret penanda tangan sesi JWT, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

PORT=3005

# Lupa kata sandi via email (Resend). Kosongkan untuk menonaktifkan; halaman tetap ada
# tetapi meminta pengguna menghubungi Owner.
# RESEND_FROM harus memakai domain yang sudah diverifikasi di Resend, mis. "Manajemen Tugas <no-reply@domainanda.com>".
# APP_URL = URL publik aplikasi, dipakai untuk tautan di email.
RESEND_API_KEY=
RESEND_FROM=
# RESEND_API_URL hanya untuk uji lokal (mengarahkan email ke stub). Jangan diisi di production.
# NODE_ENV=production diset otomatis oleh Vercel; itu yang membuat cookie sesi ber-flag Secure.
APP_URL=https://manajemen-tugas-web.vercel.app

# Nomor WhatsApp Owner (format internasional tanpa +, mis. 62812...). Dipakai di halaman lupa sandi anggota.
OWNER_CONTACT_WA=

# Vercel Cron memanggil /api/cron/daily dengan "Authorization: Bearer <CRON_SECRET>". Wajib di production.
CRON_SECRET=

# Cloudflare Turnstile (opsional). Aktif hanya jika KEDUA nilai diisi; login & lupa sandi lalu wajib lolos
# verifikasi server-side. Untuk uji lokal, Cloudflare menyediakan test key resmi (lihat dokumentasi Turnstile).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Hanya untuk database kosong: akun Owner pertama dibuat saat `npm run seed` / server lokal start.
# Hapus SEED_OWNER_PASSWORD setelah akun dibuat.
# Lokal/CI saja, tidak dipakai di Vercel:
# DB_TARGET_CONFIRM = ID endpoint Neon di DATABASE_URL (mis. ep-xxx-yyy-12345678). Wajib untuk npm run migrate / npm test.
# TEST_OWNER_EMAIL / TEST_OWNER_PASSWORD = akun Owner di branch DEV untuk npm test.
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
